{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "powershell",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy", "Bypass",
              "-File", "${CLAUDE_PLUGIN_ROOT}/scripts/run_guard.ps1"
            ],
            "timeout": 15,
            "statusMessage": "Revisando si el comando genera un entregable..."
          }
        ]
      }
    ]
  }
}
